{
  "name": "Workspace integration tests (rootless Podman + Skopeo)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "../.."
  },
  "privileged": true,
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "workspaceFolder": "/workspaces/cluster-tooling",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/cluster-tooling,type=bind",
  "postStartCommand": "bash .devcontainer/integration/check.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy",
        "editor.formatOnSave": true
      }
    }
  }
}